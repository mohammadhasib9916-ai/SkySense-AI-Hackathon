# GEMINI_API_KEY: Optional fallback or Google AI Studio integration key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEBIUS_API_KEY: Required for Nebius Token Factory & NVIDIA Nemotron LLM inference
# Obtain this from https://studio.nebius.ai/ or Token Factory console
NEBIUS_API_KEY="your_nebius_api_key_here"

# NEBIUS_MODEL: NVIDIA model identifier hosted on Nebius
# Default: nvidia/Llama-3_1-Nemotron-70B-Instruct-HF (or nvidia/nemotron-4-340b-instruct)
NEBIUS_MODEL="nvidia/Llama-3_1-Nemotron-70B-Instruct-HF"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
